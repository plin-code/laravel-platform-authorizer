{
    "name": "plin-code/laravel-platform-authorizer",
    "description": "Remote authorization for a vendor panel and signed feature flags in self-hosted Laravel installations",
    "keywords": ["PlinCode", "plin-code", "laravel", "laravel-platform-authorizer", "authorization", "feature-flags"],
    "homepage": "https://github.com/plin-code/laravel-platform-authorizer",
    "license": "MIT",
    "authors": [
        {
            "name": "Daniele Barbaro",
            "email": "barbaro.daniele@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-sodium": "*",
        "illuminate/contracts": "^12.0||^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pennant": "^1.16",
        "laravel/pint": "^1.14",
        "livewire/livewire": "^4.0",
        "nunomaduro/collision": "^8.1.1",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^3.0||^4.0",
        "pestphp/pest-plugin-arch": "^3.0||^4.0",
        "pestphp/pest-plugin-laravel": "^3.0||^4.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "suggest": {
        "laravel/pennant": "Required to read and write feature flags through the signed driver",
        "livewire/livewire": "Required to protect Livewire components of the panel"
    },
    "autoload": {
        "psr-4": {
            "PlinCode\\PlatformAuthorizer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PlinCode\\PlatformAuthorizer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PlinCode\\PlatformAuthorizer\\PlatformAuthorizerServiceProvider"
            ],
            "aliases": {
                "PlatformAuthorization": "PlinCode\\PlatformAuthorizer\\Facades\\PlatformAuthorization"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
